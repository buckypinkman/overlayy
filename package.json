{
  "name": "overlayy",
  "version": "1.0.0",
  "description": "Always-on-top PDF / image overlay that is hidden from screen recording and screen sharing.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.overlayy.app",
    "productName": "Overlayy",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/pdfjs-dist/build/pdf.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "package.json"
    ],
    "win": { "target": "portable" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
